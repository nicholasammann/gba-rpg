CompileFlags:
  Add:
    # 1. Force clangd to evaluate code using the GBA arm target
    - "-target"
    - "arm-none-eabi"
    # 2. Tell the C++ standard library that this target platform does NOT support threading
    - "-D_LIBCPP_HAS_NO_THREADS"
    - "-D_GTHREADS"
    # 3. Explicitly provide the compiler sysroot so it maps standard paths autonomously
    - "--sysroot=/opt/devkitpro/devkitARM/arm-none-eabi"
    # 4. Map the absolute engine include path from your Makefile
    - "-I/home/nick/repos/butano/butano/include"

